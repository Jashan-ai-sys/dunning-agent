# --- Database ---
# Local dev (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:5433/recovery
# Cloud SQL (GCP) example:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@/recovery?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set this to the same secret you type into Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=change_me
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# --- App ---
LOG_LEVEL=INFO
