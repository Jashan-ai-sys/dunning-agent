# --- Database ---
# Local dev (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:5433/recovery
# Cloud SQL (GCP) example:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@/recovery?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set this to the same secret you type into Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=change_me
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# --- App ---
LOG_LEVEL=INFO

# --- LiveKit (voice) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=dunning-agent
# Outbound SIP trunk id, created in LiveKit against a SIP provider
# (Twilio/Plivo/Exotel). Without it there is no way to dial PSTN.
LIVEKIT_SIP_TRUNK_ID=

# --- Twilio (outbound telephony) ---
# The reachable alternative to a LiveKit SIP trunk, and what the worker picks
# first when both are set. A trial account issues a number in minutes; it does
# not have to be Indian, because a US number dialling a verified mobile
# exercises the same loop.
#
#   1. Verify the mobile you will call: Console > Phone Numbers > Manage >
#      Verified Caller IDs. Trial accounts may only dial verified numbers.
#   2. Console > Voice > Settings > Geo Permissions -> tick India, or the dial
#      fails with a permissions error rather than ringing.
#   3. Buy a Voice-capable number and put it in TWILIO_FROM_NUMBER (E.164).
#   4. Expose the agent: `ngrok http 7860`, then set TWILIO_STREAM_URL to the
#      wss:// form of that host with the /ws path.
#
# Run the agent on the telephony transport so /ws exists:
#   uv run --group pipecat python -m app.voice.pipecat_agent -t telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public and wss://, never localhost: Twilio dials from its own network.
TWILIO_STREAM_URL=wss://your-tunnel.ngrok.app/ws

# --- Voice stack ---
SARVAM_API_KEY=
# saaras:v4 is beta and whitelisted per key; saaras:v3 is the general default.
SARVAM_STT_MODEL=saaras:v4
CARTESIA_API_KEY=
# Arushi - Hinglish Speaker
CARTESIA_VOICE=95d51f79-c397-46f9-b49a-23763d3eaa2d
COMPANY_NAME=Acme

# --- Gemini ---
# Vertex AI (default): authenticates with ADC or a service account, no API key.
#   gcloud auth application-default login
# vertex | local. "local" targets any OpenAI-compatible server (SGLang, vLLM),
# so a self-hosted SLM needs no code change. Speculative decoding is configured
# on the server, not here.
LLM_PROVIDER=vertex
LOCAL_LLM_BASE_URL=http://localhost:30000/v1
LOCAL_LLM_MODEL=LiquidAI/LFM2.5-8B-A1B

GOOGLE_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
# Either run `gcloud auth application-default login`, or point this at a
# service-account key with roles/aiplatform.user. Keep the file out of the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Or set GOOGLE_USE_VERTEX=false and use the Gemini Developer API instead:
# GOOGLE_API_KEY=
