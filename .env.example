# --- Database ---
# Local dev (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:5433/recovery
# Cloud SQL (GCP) example:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@/recovery?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set this to the same secret you type into Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=change_me
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# --- App ---
LOG_LEVEL=INFO

# --- LiveKit (voice) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=dunning-agent
# Outbound SIP trunk id, created in LiveKit against a SIP provider
# (Twilio/Plivo/Exotel). Without it there is no way to dial PSTN.
LIVEKIT_SIP_TRUNK_ID=

# --- Twilio (outbound telephony) ---
# The reachable alternative to a LiveKit SIP trunk, and what the worker picks
# first when both are set. A trial account issues a number in minutes; it does
# not have to be Indian, because a US number dialling a verified mobile
# exercises the same loop.
#
#   1. Verify the mobile you will call: Console > Phone Numbers > Manage >
#      Verified Caller IDs. Trial accounts may only dial verified numbers.
#   2. Console > Voice > Settings > Geo Permissions -> tick India, or the dial
#      fails with a permissions error rather than ringing.
#   3. Buy a Voice-capable number and put it in TWILIO_FROM_NUMBER (E.164).
#   4. Expose the agent: `ngrok http 7860`, then set TWILIO_STREAM_URL to the
#      wss:// form of that host with the /ws path.
#
# Run the agent on the telephony transport so /ws exists:
#   uv run --group pipecat python -m app.voice.pipecat_agent -t telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public and wss://, never localhost: Twilio dials from its own network.
TWILIO_STREAM_URL=wss://your-tunnel.ngrok.app/ws

# --- Voice stack ---
SARVAM_API_KEY=
# saaras:v4 is beta and whitelisted per key; saaras:v3 is the general default.
SARVAM_STT_MODEL=saaras:v4
CARTESIA_API_KEY=
# Arushi - Hinglish Speaker
CARTESIA_VOICE=95d51f79-c397-46f9-b49a-23763d3eaa2d
COMPANY_NAME=Acme

# --- Gemini ---
# Vertex AI (default): authenticates with ADC or a service account, no API key.
#   gcloud auth application-default login
# vertex | local. "local" targets any OpenAI-compatible server (SGLang, vLLM),
# so a self-hosted SLM needs no code change. Speculative decoding is configured
# on the server, not here.
LLM_PROVIDER=vertex
LOCAL_LLM_BASE_URL=http://localhost:30000/v1
LOCAL_LLM_MODEL=LiquidAI/LFM2.5-8B-A1B

# NeMo Guardrails output rails: off | audit | block.
#   audit  streams normally and logs what it would have stopped (~3ms/turn)
#   block  holds each turn until the rail clears it. Safe, but forfeits
#          progressive TTS and with it the 0.058s time to first byte.
# Off by default so the dependency changes nothing until someone chooses it.
GUARDRAILS_MODE=off

GOOGLE_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
# Either run `gcloud auth application-default login`, or point this at a
# service-account key with roles/aiplatform.user. Keep the file out of the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Or set GOOGLE_USE_VERTEX=false and use the Gemini Developer API instead:
# GOOGLE_API_KEY=

# --- Things that are OFF unless you set them ---------------------------------
# Each of these disables a whole feature when empty. That is deliberate -- none
# of them should switch themselves on in a deployment that did not ask for it --
# but it does mean a missing value looks like a feature that silently does
# nothing rather than an error.

# Appended to every payment link reference_id. Razorpay enforces reference_id
# uniqueness across the whole account, forever, and case ids restart at 1 on a
# fresh database -- so a redeploy against a new instance collides with links
# the account already holds and every first link 400s. Set it to anything short
# and distinct per deployment.
PAYMENT_REFERENCE_NAMESPACE=

# Answering machine detection. Empty disables it however MACHINE_DETECTION_ENABLED
# is set: a verdict nobody can receive changes nothing about the call and still
# costs Twilio's AMD fee. Point it at this service's public URL.
# TWILIO_AMD_CALLBACK_URL=https://your-service.run.app/webhooks/twilio/amd
MACHINE_DETECTION_ENABLED=true
MACHINE_DETECTION_TIMEOUT=30

# Shared cache. Empty means no Redis, which is supported: every cache call
# degrades to a miss and the service behaves exactly as it did before. Redis is
# a fast path here, never the authority -- Postgres still decides.
REDIS_URL=

# Push delivery for webhook events. Empty means cron-only: the five-minute
# sweep still finds every envelope, just later. The push endpoint refuses
# outright without a service account -- it dispatches handlers that create
# payment links and place calls, so it does not run unauthenticated.
PUBSUB_TOPIC=
PUBSUB_PUSH_SERVICE_ACCOUNT=
PUBSUB_PUSH_AUDIENCE=

# --- Policy knobs, shown at their defaults ------------------------------------
# Minimum gap between contacting the same *person*, whatever the debt. Distinct
# from RETRY_BACKOFF_HOURS, which bounds one case.
CUSTOMER_CONTACT_COOLDOWN_HOURS=24
# How long to defer to Razorpay's own retry sequence before working a bank-side
# failure ourselves. Bounded by a clock rather than by subscription.halted,
# because that webhook may never arrive.
BANK_RETRY_GRACE_HOURS=72
# How long after a failed checkout before it counts as abandoned.
CHECKOUT_GRACE_MINUTES=30
# How long a "I will pay" commitment stands before it counts as broken.
PROMISE_WINDOW_HOURS=48
# Speak a rendered opening line instead of asking the LLM for one. Saves a
# round trip at the moment the customer is listening hardest.
CACHED_GREETING_ENABLED=true
# Re-charge a still-valid mandate instead of sending a link, when the only
# thing that went wrong was that the money was not there. Off by default: it is
# the one path that takes money without the customer doing anything.
MANDATE_RETRY_ENABLED=false

# --- Sarvam server-side VAD (saaras:v3) --------------------------------------
# Distinct from the Silero settings: Silero decides whether we are listening,
# these decide whether Sarvam turns what it hears into words. A barge-in needs
# both -- Silero opens the turn, and the audio has to transcribe into enough
# words to pass the word threshold.
#
# All unset by default, meaning Sarvam's own defaults apply. Set them when a
# line needs it; the right values depend on the call, and finding them means
# changing a number and listening.
#
# Volume (dB) below which audio is too quiet to be speech. The most direct
# answer to a television in the next room being transcribed into words.
# SARVAM_START_SPEECH_VOLUME_THRESHOLD=-35
# Consecutive speech frames needed to open a segment -- a cough or a door
# never lasts long enough to become a word.
# SARVAM_MIN_SPEECH_FRAMES=4
# The same, for registering a barge-in specifically.
# SARVAM_INTERRUPT_MIN_SPEECH_FRAMES=6
# VAD probability (0-1) above which a frame counts as speech.
# SARVAM_POSITIVE_SPEECH_THRESHOLD=0.6
# SARVAM_NEGATIVE_SPEECH_THRESHOLD=0.3
# Frames prepended before detected onset, to recover the clipped first syllable
# that raising the thresholds above tends to cost.
# SARVAM_PRE_SPEECH_PAD_FRAMES=2
